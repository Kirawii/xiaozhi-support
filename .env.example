# 星川商城仿真环境配置示例。全部为虚构值，复制为 .env 后按需修改。
# 不设置任何变量也能运行：下面的默认值就是代码里的默认值。
# 说明：程序不会自动读取 .env 文件；用 `uv run --env-file .env ...` 或自行导出环境变量。

# ---- 三类访问凭证（虚构） ----
# cs-agent：学习者的 Agent 使用，只能读写业务服务
#   大多数服务：Authorization: Bearer <token>
#   物流服务：X-Express-Token: <token>
XC_TOKEN_CS_AGENT=xc-demo-cs-agent-token
# internal：服务之间互相调用、调用 /_sim/* 内部接口
XC_TOKEN_INTERNAL=xc-demo-internal-token
# control：只能访问控制服务，请求头 X-Control-Token
XC_TOKEN_CONTROL=xc-demo-control-token

# ---- 仿真时钟与数据 ----
# 锚点 N：仿真时间默认冻结在这一刻（北京时间）。合法范围 2026-10-17 ~ 2027-12-31
XC_ANCHOR=2026-11-01T10:00:00+08:00
# 随机种子：同一种子生成的数据完全一致
XC_SEED=42
# 异步任务（如退款处理中 -> 成功）的墙钟自动推进秒数；0 表示关闭，只靠仿真时间推进
XC_AUTO_SETTLE_SECONDS=5
# 数据库与快照目录
XC_DATA_DIR=data

# ---- 服务基地址 ----
# 单进程模式：所有服务共用一个地址（路径里带服务前缀，如 /order/v1/...）
XC_BASE_URL=http://127.0.0.1:8000
# docker-compose 模式：按服务单独指定，未指定的服务回落到 XC_BASE_URL
# XC_CATALOG_URL=http://127.0.0.1:8101
# XC_ORDER_URL=http://127.0.0.1:8102
# XC_LOGISTICS_URL=http://127.0.0.1:8103
# XC_PAYMENT_URL=http://127.0.0.1:8104
# XC_MEMBER_URL=http://127.0.0.1:8105
# XC_AFTERSALE_URL=http://127.0.0.1:8106
# XC_TICKET_URL=http://127.0.0.1:8107
# XC_CONTROL_URL=http://127.0.0.1:8100

# ---- 规则文件（一般不用改；变异测试会用到）----
# XC_POLICY_PATH=policy/policy.yaml
