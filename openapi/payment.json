  "info": {
    "description": "支付记录、退款（异步、幂等、可能超时未知）、余额。风格：snake_case 裸 JSON，错误为 problem+json，金额为整数分，时间为 epoch 毫秒。（当前为接口桩）",
    "title": "星川商城 · 支付与退款服务 payment",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/payment/health": {
      "get": {
        "operationId": "health_payment_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Payment Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "健康检查（无需鉴权）",
        "tags": [
          "infra"
        ]
      }
    },
