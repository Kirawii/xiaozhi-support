  "info": {
    "description": "轨迹、包裹、签收信息、报障。风格：camelCase 缩写，永远 HTTP 200，看 success/errCode；鉴权头 X-Express-Token；时间为北京时间字符串。（当前为接口桩）",
    "title": "星川商城 · 物流服务 logistics",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/logistics/health": {
      "get": {
        "operationId": "health_logistics_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Logistics Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "健康检查（无需鉴权）",
        "tags": [
          "infra"
        ]
      }
    },
